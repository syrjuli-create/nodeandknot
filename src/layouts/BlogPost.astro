---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	currentId?: string;
	hideMeta?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, headings, currentId, hideMeta } = Astro.props;
const hasSidebar = headings !== undefined && currentId !== undefined;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
			}
			main.with-sidebar {
				width: 1080px;
			}
			.title {
				padding: 1em 0 0;
			}
			.title h1 {
				margin: 0;
				font-size: 2.2em;
				line-height: 1.35;
			}
			.meta {
				margin-top: 0.8em;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.hero-image {
				margin-top: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 16px;
			}
			.prose {
				margin-top: 2.5em;
			}
			.with-sidebar {
				display: grid;
				grid-template-columns: 220px minmax(0, 720px);
				gap: 4em;
				justify-content: center;
				align-items: start;
			}
			.with-sidebar .side {
				position: sticky;
				top: 92px;
				padding-top: 1.5em;
				max-height: calc(100vh - 110px);
				overflow-y: auto;
			}
			@media (max-width: 1100px) {
				.with-sidebar {
					grid-template-columns: minmax(0, 1fr);
					gap: 2em;
				}
				main.with-sidebar {
					width: 720px;
				}
				.with-sidebar .side {
					order: 2;
					position: static;
					padding: 2em 0 0;
					max-height: none;
					border-top: 1px solid rgb(var(--gray-light));
				}
			}
			@media (max-width: 720px) {
				.title h1 {
					font-size: 1.6em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class={hasSidebar ? 'with-sidebar' : undefined}>
			{
				headings && currentId && (
					<div class="side">
						<Sidebar headings={headings} currentId={currentId} />
					</div>
				)
			}
			<article>
				<header class="title">
					<h1>{title}</h1>
					{!hideMeta && (
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span>
								{' · 수정 '}
								<FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					)}
				</header>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1440} height={720} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
