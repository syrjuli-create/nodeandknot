---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Brand from '../components/Brand.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { categoryHref, categorySlug, type NavSection } from '../lib/nav';

type Props = Omit<CollectionEntry<'blog'>['data'], 'category'> & {
	category?: string;
	sidebar?: NavSection[];
	hideMeta?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, category, sidebar, hideMeta } =
	Astro.props;
const BRAND = 'Node & Knot';
const titleParts = title.split(BRAND);
const hasSidebar = sidebar !== undefined && sidebar.length > 0;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.title {
				padding: 1em 0 0;
			}
			.title h1 {
				margin: 0;
				font-size: 35px;
				line-height: 1.35;
			}
			.meta {
				margin-top: 0.8em;
				font-size: 12px;
				color: rgb(var(--gray));
			}
			.hero-image {
				margin-top: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 16px;
			}
			.prose {
				margin-top: 2.5em;
			}
			.meta a {
				color: inherit;
				text-decoration: none;
			}
			.meta a:hover {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.title h1 {
					font-size: 24px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class={hasSidebar ? 'with-sidebar' : undefined}>
			{
				sidebar && hasSidebar && (
					<div class="side">
						<Sidebar sections={sidebar} />
					</div>
				)
			}
			<article>
				<header class="title">
					<h1>
						{titleParts.map((part, i) => (
							<>
								{i > 0 && <Brand />}
								{part}
							</>
						))}
					</h1>
					{!hideMeta && (
					<div class="meta">
						{category && (
							<>
								<a href={categoryHref(categorySlug(category))}>{category}</a>
								{' · '}
							</>
						)}
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span>
								{' · 수정 '}
								<FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					)}
				</header>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1440} height={720} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
