---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Brand from '../components/Brand.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { categoryHref, categorySection, categorySlug, getPosts, type NavSection } from '../lib/nav';

type Props = Omit<CollectionEntry<'blog'>['data'], 'category' | 'tags' | 'draft'> & {
	category?: string;
	tags?: string[];
	draft?: boolean;
	sidebar?: NavSection[];
	hideMeta?: boolean;
};

const {
	title,
	subtitle,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags,
	draft,
	sidebar,
	hideMeta,
} = Astro.props;
const BRAND = 'Node & Knot';
const titleParts = title.split(BRAND);
// 카테고리 메뉴는 어느 페이지에서나 맨 위에 고정으로 보여 준다.
const sections: NavSection[] = [
	categorySection(await getPosts(), category ? categorySlug(category) : undefined),
	...(sidebar ?? []),
];
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.title {
				padding: 1em 0 0;
			}
			.title h1 {
				margin: 0;
				font-size: 35px;
				line-height: 1.35;
			}
			.title h1 .subtitle {
				margin-left: 0.4em;
				font-size: 0.5em;
				font-weight: 400;
				color: rgb(var(--gray));
			}
			.meta {
				margin-top: 0.8em;
				font-size: 12px;
				color: rgb(var(--gray));
			}
			.hero-image {
				margin-top: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 16px;
			}
			.prose {
				margin-top: 2.5em;
			}
			.meta a {
				color: inherit;
				text-decoration: none;
			}
			.meta a:hover {
				color: var(--accent);
			}
			.draft-banner {
				margin: 1em 0 0;
				padding: 10px 14px;
				border-radius: 12px;
				background: var(--accent-soft);
				color: var(--accent-dark);
				font-size: 13px;
			}
			.draft-banner a {
				color: inherit;
				font-weight: 600;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin: 3em 0 0;
				padding: 0;
				list-style: none;
			}
			.tags li {
				padding: 4px 10px;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 13px;
			}
			@media (max-width: 720px) {
				.title h1 {
					font-size: 24px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="with-sidebar">
			<div class="side">
				<Sidebar sections={sections} />
			</div>
			<article>
				<header class="title">
					{draft && (
						<p class="draft-banner">
							초안이에요. 배포에는 나가지 않아요. 다 쓰면 머리말의 <code>draft: true</code> 를 지워 주세요. ·{' '}
							<a href="/preview/">미리보기로 돌아가기</a>
						</p>
					)}
					<h1>
						{titleParts.map((part, i) => (
							<>
								{i > 0 && <Brand />}
								{part}
							</>
						))}
						{subtitle && <small class="subtitle">({subtitle})</small>}
					</h1>
					{!hideMeta && (
					<div class="meta">
						{category && (
							<>
								<a href={categoryHref(categorySlug(category))}>{category}</a>
								{' · '}
							</>
						)}
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span>
								{' · 수정 '}
								<FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					)}
				</header>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1440} height={720} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{tags && tags.length > 0 && (
					<ul class="tags" aria-label="태그">
						{tags.map((tag) => <li>#{tag}</li>)}
					</ul>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
