---
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import SidebarPage from '../../layouts/SidebarPage.astro';
import {
	aiProjectsSection,
	categorySection,
	getPosts,
	postsSection,
	usedCategories,
} from '../../lib/nav';

const posts = await getPosts();
const sections = [
	categorySection(posts, 'all'),
	aiProjectsSection(),
	...usedCategories(posts).map((c) =>
		postsSection(
			c.name,
			posts.filter((p) => p.data.category === c.name),
		),
	),
];
---

<SidebarPage title={`Blog | ${SITE_TITLE}`} description="전체 글 목록" sections={sections}>
	<section class="intro">
		<h1>전체 글</h1>
		<p>뜨개질하는 개발자의 기록</p>
	</section>
	<PostList posts={posts} />
</SidebarPage>
