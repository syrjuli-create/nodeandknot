---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { READING } from '../data/reading';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`읽을거리 | ${SITE_TITLE}`} description="함께 읽으면 좋은 글 모음" />
		<style>
			.intro {
				margin: 1.5em 0 2em;
			}
			.intro h1 {
				margin: 0;
				font-size: 35px;
			}
			.intro p {
				margin: 0.4em 0 0;
				color: rgb(var(--gray-dark));
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li + li {
				margin-top: 0.5em;
			}
			a {
				display: block;
				margin: 0 -1em;
				padding: 1.5em 1em;
				border-radius: 20px;
				text-decoration: none;
				transition: background-color 0.15s ease;
			}
			a:hover {
				background: rgba(var(--gray-light), 0.6);
			}
			.title {
				margin: 0;
				font-size: 20px;
				line-height: 1.45;
				color: rgb(var(--black));
			}
			a:hover .title {
				color: var(--accent);
			}
			.desc {
				margin: 0.5em 0 0;
				font-size: 14px;
				line-height: 1.6;
				color: rgb(var(--gray-dark));
			}
			.source {
				margin: 0.8em 0 0;
				font-size: 12px;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.intro h1 {
					font-size: 25px;
				}
				.title {
					font-size: 16px;
				}
				.desc {
					font-size: 12px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>읽을거리</h1>
				<p>함께 읽으면 좋은 글 모음</p>
			</section>
			<ul>
				{
					READING.map((item) => (
						<li>
							<a href={item.url} target="_blank" rel="noopener noreferrer">
								<h3 class="title">{item.title}</h3>
								<p class="desc">{item.description}</p>
								<p class="source">{item.source} ↗</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
