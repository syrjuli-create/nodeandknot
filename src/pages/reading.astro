---
import { SITE_TITLE } from '../consts';
import { READING } from '../data/reading';
import SidebarPage from '../layouts/SidebarPage.astro';
import type { NavSection } from '../lib/nav';

// 분류별로 묶는다. 처음 나온 순서를 유지한다.
const groups = [...new Set(READING.map((r) => r.category))].map((name, i) => ({
	name,
	id: `group-${i + 1}`,
	items: READING.filter((r) => r.category === name),
}));

const sections: NavSection[] = [
	{
		label: '분류',
		items: groups.map((g) => ({ text: g.name, href: `#${g.id}`, count: g.items.length })),
	},
];
---

<SidebarPage title={`읽을거리 | ${SITE_TITLE}`} description="함께 읽으면 좋은 글 모음" sections={sections}>
	<section class="intro">
		<h1>읽을거리</h1>
		<p>함께 읽으면 좋은 글 모음</p>
	</section>
	{
		groups.map((g) => (
			<section class="group">
				<h2 id={g.id}>{g.name}</h2>
				<ul>
					{g.items.map((item) => (
						<li>
							<a href={item.url} target="_blank" rel="noopener noreferrer">
								<h3 class="title">{item.title}</h3>
								<p class="desc">{item.description}</p>
								<p class="source">{item.source} ↗</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</SidebarPage>

<style>
	.group + .group {
		margin-top: 2.5em;
	}
	.group h2 {
		margin: 0 0 0.3em;
		font-size: 17px;
		color: rgb(var(--gray-dark));
		scroll-margin-top: 80px;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li + li {
		margin-top: 0.5em;
	}
	a {
		display: block;
		margin: 0 -1em;
		padding: 1.2em 1em;
		border-radius: 20px;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	a:hover {
		background: rgba(var(--gray-light), 0.6);
	}
	.title {
		margin: 0;
		font-size: 20px;
		line-height: 1.45;
		color: rgb(var(--black));
	}
	a:hover .title {
		color: var(--accent);
	}
	.desc {
		margin: 0.5em 0 0;
		font-size: 14px;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
	}
	.source {
		margin: 0.8em 0 0;
		font-size: 12px;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.title {
			font-size: 16px;
		}
		.desc {
			font-size: 12px;
		}
	}
</style>
