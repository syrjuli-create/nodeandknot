---
import type { NavSection } from '../lib/nav';

interface Props {
	sections: NavSection[];
}

const { sections } = Astro.props;
---

<aside class="sidebar">
	{
		sections.map((section) => (
			<nav class="block" aria-label={section.label}>
				<p class="label">{section.label}</p>
				<ul>
					{section.items.map((item) => (
						<li class={item.indent ? 'indent' : undefined}>
							<a
								href={item.href}
								class={item.current ? 'current' : undefined}
								aria-current={item.current ? 'page' : undefined}
							>
								<span class="text">{item.text}</span>
								{item.count !== undefined && <span class="count">{item.count}</span>}
							</a>
						</li>
					))}
				</ul>
			</nav>
		))
	}
</aside>

<style>
	.sidebar {
		font-size: 12.5px;
		line-height: 1.5;
	}
	.block + .block {
		margin-top: 2em;
	}
	.label {
		margin: 0 0 0.6em 0;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 2px solid rgb(var(--gray-light));
	}
	li {
		margin: 0;
	}
	li.indent {
		padding-left: 0.9em;
	}
	a {
		display: flex;
		justify-content: space-between;
		gap: 0.5em;
		margin-left: -2px;
		padding: 0.3em 0 0.3em 0.9em;
		border-left: 2px solid transparent;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	a.current {
		border-left-color: var(--accent);
		color: var(--accent);
		font-weight: 600;
	}
	.count {
		flex: none;
		color: rgb(var(--gray));
		font-weight: 400;
	}
</style>
