---
import Brand from './Brand.astro';

const today = new Date();
---

<footer>
	<div class="inner">
		&copy; {today.getFullYear()} <Brand />
		<span class="sep">·</span>
		<a href="/privacy/">개인정보처리방침</a>
		<span class="sep">·</span>
		<a href="/contact/">문의하기</a>
	</div>
</footer>
<style>
	footer {
		margin-top: 4em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 12px;
	}
	.inner {
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 0 3em;
	}
	.sep {
		margin: 0 0.5em;
	}
	.inner a {
		color: inherit;
		text-decoration: none;
	}
	.inner a:hover {
		color: var(--accent);
	}
</style>
