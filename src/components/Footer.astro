---
import Brand from './Brand.astro';

const today = new Date();
---

<footer>
	<div class="inner">&copy; {today.getFullYear()} <Brand /></div>
</footer>
<style>
	footer {
		margin-top: 4em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 12px;
	}
	.inner {
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 0 3em;
	}
</style>
